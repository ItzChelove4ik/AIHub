# TLS from Let's Encrypt for AIHUB_DOMAIN (a domain, or <ip>.sslip.io).
{$AIHUB_DOMAIN} {
	encode {
		# Never compress the chat stream: it must reach the phone as it comes.
		match {
			not header Content-Type text/event-stream*
		}
		gzip
	}
	reverse_proxy aihub-backend:8080 {
		# SSE: pass every chunk on at once.
		flush_interval -1
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	# Access log. Caddy redacts Authorization and Cookie itself; the OAuth
	# callback's code and state are removed from the query.
	log {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}
