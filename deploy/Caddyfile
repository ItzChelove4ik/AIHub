# TLS from Let's Encrypt for AIHUB_DOMAIN (a domain, or <ip>.sslip.io).
# The HTTPS port is configurable: 443 may already belong to a VPN on the
# same VPS. Certificates come over HTTP-01 on port 80 either way.
{$AIHUB_DOMAIN}:{$AIHUB_HTTPS_PORT} {
	# No encode: the chat stream (SSE) must not be buffered by compression,
	# JSON answers are small and images are compressed already.
	reverse_proxy aihub-backend:8080 {
		# SSE: pass every chunk on at once.
		flush_interval -1
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
	# Access log. Caddy redacts Authorization and Cookie itself; the OAuth
	# callback's code and state are removed from the query.
	log {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}
