# AIHub backend settings. Copy to .env (never commit .env) and fill in.
# Every value here is a placeholder.

# 32 random bytes as 64 hex characters: openssl rand -hex 32
# Encrypts provider keys (AES-256-GCM) and signs access tokens. Losing it
# makes stored provider keys unreadable; changing it signs everyone out.
AIHUB_MASTER_KEY=

# Public https address of the server (OpenRouter OAuth callback).
AIHUB_PUBLIC_URL=http://localhost:8080
AIHUB_LISTEN=:8080
AIHUB_DB_PATH=aihub.db
AIHUB_LOG_LEVEL=info

# Admin: the first registered account, or this email when set.
ADMIN_EMAIL=
# open: anyone can register; invite: only with an invite code from the admin
AIHUB_REGISTRATION=open
# true only behind a reverse proxy (Caddy) that sets X-Forwarded-For
AIHUB_TRUST_PROXY=false
# Custom OpenAI-compatible providers on private/loopback addresses (and http://)
AIHUB_ALLOW_PRIVATE_BASE_URLS=false

# Daily limits for every user unless the admin sets their own; 0 = unlimited
AIHUB_DEFAULT_DAILY_REQUESTS=0
AIHUB_DEFAULT_DAILY_TOKENS=0

# --- OpenFlux channels (the "Server" tab) ---
# off | socket (aihub-nodectl serve, for Docker) | exec (sudo aihub-nodectl)
NODECTL_MODE=off
NODECTL_SOCKET=/run/aihub-nodectl/nodectl.sock
NODECTL_COMMAND=sudo -n /usr/local/bin/aihub-nodectl
# Host the phones dial for the direct transport (domain or IP of the VPS)
TUNNEL_PUBLIC_HOST=
TUNNEL_PORT_MIN=20000
TUNNEL_PORT_MAX=20999
# Create cups.online rooms for every new channel
TUNNEL_CUPSONLINE=true
